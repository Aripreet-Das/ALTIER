# Where the Expo app looks for your Mac. Copy to app/.env and set the address.
#
# This is your Mac's address on the current wifi — it changes when you join a different
# network. Find it with:  ipconfig getifaddr en0   (macOS)
#
# Same wifi:
#   EXPO_PUBLIC_ALTIER_API=http://192.168.1.10:8000
# Tailscale (reachable anywhere):
#   EXPO_PUBLIC_ALTIER_API=http://your-mac.tailnet-name.ts.net:8000
#
# Both services, if you started the full stack with ./start-all.sh:
EXPO_PUBLIC_ALTIER_API=http://localhost:8000
EXPO_PUBLIC_ALTIER_API_PERSONAL_STYLIST=http://localhost:8090
